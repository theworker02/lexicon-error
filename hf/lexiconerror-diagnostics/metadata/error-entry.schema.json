{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lexiconerror.dev/schemas/error-entry.json",
  "title": "LexiconError diagnostic entry",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "language", "code", "category", "severity", "title", "description", "bad_example", "good_example"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)+$", "minLength": 3 },
    "language": { "type": "string", "minLength": 1 },
    "code": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "severity": { "type": "string", "enum": ["Compiler Error", "Warning", "Runtime Exception", "Linter Rule", "Fatal", "Undefined Behavior"] },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 16 },
    "bad_example": { "type": "string", "minLength": 1 },
    "good_example": { "type": "string", "minLength": 1 },
    "version_introduced": { "type": ["string", "null"] },
    "version_deprecated": { "type": ["string", "null"] },
    "source_url": { "type": ["string", "null"], "format": "uri", "description": "Canonical documentation URL. source_reference is accepted as a contribution-friendly alias." },
    "source_reference": { "type": ["string", "null"], "format": "uri", "description": "Contribution alias for source_url; normalized to source_url when imported." },
    "tier": { "type": "integer", "minimum": 1, "maximum": 4 },
    "frequency": { "type": "string", "enum": ["Common", "Uncommon", "Rare", "Situational"] },
    "situational_context": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "interaction_types": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "related_errors": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)+$" }, "uniqueItems": true },
    "state_snapshot": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["event", "frames", "variables"],
      "properties": {
        "event": { "type": "string" },
        "frames": { "type": "array", "items": { "type": "string" } },
        "variables": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "value", "status"], "properties": { "name": { "type": "string" }, "value": { "type": "string" }, "status": { "type": "string" } } } }
      }
    }
  }
}
